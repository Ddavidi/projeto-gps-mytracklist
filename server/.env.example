# === Banco de Dados (PostgreSQL de DEV — Neon ou Supabase) ===
# Por padrão, tudo que roda localmente conecta no banco PostgreSQL da DEV.
# Deixe DB_TYPE sem definir (ou "postgres") para usar o PostgreSQL abaixo.
DATABASE_URL=postgresql://user:password@host/mytracklist_dev?sslmode=require

# === Spotify API ===
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Local: use 127.0.0.1 para bater com a URI registrada no Spotify Developer Dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/v1/auth/spotify/callback

# === Cloudinary (Uploads de Avatar e Capa) ===
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === Administradores ===
# E-mails (separados por vírgula) que viram admin automaticamente ao entrar.
ADMIN_EMAILS=

# === JWT Authentication ===
JWT_SECRET=your_super_secret_jwt_key_change_this

# === Server ===
PORT=3000
NODE_ENV=development
APP_ENV=development

# === Frontend & CORS ===
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# === E-mail (Brevo API para Verificação em Duas Etapas no Cadastro) ===
# Se não preenchido em dev/local, o código de 6 dígitos é exibido no terminal do backend.
BREVO_API_KEY=your_brevo_api_key
MAIL_FROM_EMAIL=seu_email_verificado@exemplo.com
MAIL_FROM_NAME=MyTrackList
