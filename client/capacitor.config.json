{
  "appId": "com.mytracklist.app",
  "appName": "MyTrackList",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https"
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0B0E11",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0B0E11",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
